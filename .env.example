# Copy to repo-root `.env` on the server (never commit `.env`).
# Local laptop: omit this file — compose defaults to localhost.

# Public API URL baked into the Next.js web image at build time
NEXT_PUBLIC_API_URL=https://yourname.duckdns.org/api

# Browser / OAuth (must match live site)
CORS_ORIGIN=https://yourname.duckdns.org
GOOGLE_REDIRECT_URI=https://yourname.duckdns.org/api/auth/google/callback

# Shared secrets (same values on api + worker + ai)
JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-long-random
INTERNAL_API_SECRET=change-me-long-random
