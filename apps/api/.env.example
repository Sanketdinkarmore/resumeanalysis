# Copy to apps/api/.env for local development (never commit .env)

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Matches docker-compose postgres service
DATABASE_URL=postgresql://jri:jri@localhost:5432/jri?schema=public

# Auth — use long random strings in real deploys; these are local-only
JWT_ACCESS_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Google OAuth — register redirect URI in Google Cloud Console
# Local: GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Authorized JS origin: http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=jriminio
S3_SECRET_ACCESS_KEY=jriminio123
S3_BUCKET=resumes
S3_FORCE_PATH_STYLE=true

# FastAPI AI service (internal — must match apps/ai/.env INTERNAL_API_SECRET)
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_SECRET=local-dev-internal-secret-change-me
