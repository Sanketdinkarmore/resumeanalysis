# Copy to apps/ai/.env for local development (never commit .env)

ENV=development
PORT=8000

# Shared secret — Express sends this when calling FastAPI
INTERNAL_API_SECRET=local-dev-internal-secret-change-me

# Preferred LLM for interview (+ enrich): Groq → Gemini → templates
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
